{
  "expo": {
    "name": "luvin-frontend-v2",
    "slug": "luvin-frontend-v2",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "luvinfrontendv2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.luvinfrontendv2"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.luvinfrontendv2"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "backgroundColor": "#208AEF"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
