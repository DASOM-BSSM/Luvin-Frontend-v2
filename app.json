{
  "expo": {
    "name": "러빈",
    "slug": "luvin-frontend-v2",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "default",
    "scheme": "luvinfrontendv2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.dasom.luvinapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.dasom.luvinapp"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFEFA"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1001491587399-5jdsvkhob5kg4giaa462staik2jqj64v"
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfdcb524-5641-4dd0-88d0-eeff62d9fc62"
      }
    }
  }
}
