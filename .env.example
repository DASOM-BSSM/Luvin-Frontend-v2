VITE_API_URL=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# ---------------------------------------------------------------------------
# [DRAFT] 러빈지옥 목 서버 (개발·기기 테스트 전용)
# ⚠️ 배포 빌드(TestFlight·Play 내부 테스트·스토어) 전에 EXPO_PUBLIC_USE_MOCK 를 반드시 비우거나
#    false 로 둘 것. EXPO_PUBLIC_ 값은 앱 번들에 그대로 들어가서, 켜 둔 채 빌드하면 실제 서버 대신
#    목 데이터가 나간다. 값을 바꾼 뒤에는 `pnpm start --clear` 로 번들러를 다시 띄워야 반영된다.
# ---------------------------------------------------------------------------
# true 면 러빈지옥 회차·선택·완료·회차 열기·쪽지·최종 리포트를 서버 대신 목 서버로 처리한다
EXPO_PUBLIC_USE_MOCK=
# 목 수락·거절 시나리오: default | all-accept | ep6-reject
EXPO_PUBLIC_MOCK_SCENARIO=default
# 목 모드의 처음 나이. 비우면 나이가 없는 상태로 시작해 1화에서 나이 입력 바텀시트가 뜬다
EXPO_PUBLIC_MOCK_AGE=
# 목 모드의 처음 토큰 개수(4화부터 회차 열기에 쓴다). 비우면 3. 목의 회차 열기 비용은 1이다
EXPO_PUBLIC_MOCK_TOKENS=
